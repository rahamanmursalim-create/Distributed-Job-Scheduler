# ----- Build outputs -----
**/target/
**/build/
**/out/

# ----- Gradle -----
**/.gradle/
**/gradle-app.setting
!gradle-wrapper.jar

# ----- Node / Frontend -----
**/node_modules/
**/dist/
**/.cache/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ----- IDE files -----
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.eclipse
.vscode/
*.code-workspace
nbproject/

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Java -----
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ----- Maven -----
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# ----- Spring Boot -----
application-local.yml
application-local.properties

# ----- Logs -----
*.log
logs/

# ----- Temp / scratch -----
*.tmp
*.bak
*.swp
*~
old-files-over-14-days.csv
JAVA27_MIGRATION_STATUS.md
